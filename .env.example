# ============================================
# SISTEM DATA LOADING MG — ENV FRONTEND
# Copy ke .env lokal, dan set yang sama di Cloudflare Pages
# ============================================

# Backend API di Coolify (WAJIB, pengganti Supabase)
# Contoh: https://api-projectpg.prasastigroup.id
VITE_API_URL=http://localhost:3001

# S3 Onidel Cloud (TETAP — file tidak pindah, tidak hilang)
VITE_S3_ACCESS_KEY=your_access_key_here
VITE_S3_SECRET_KEY=your_secret_key_here

# Note:
# - Login pakai akun di database (tabel users), bukan password di env lagi.
# - VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY sudah TIDAK dipakai lagi
# - Endpoint S3: s3.ap-southeast-1.onidel.cloud
# - Region: ap-southeast-1, Bucket: loading
