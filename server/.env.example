# Copy ke .env di Coolify (jangan commit isi aslinya)
DATABASE_URL=postgresql://postgres:ISI_PASSWORD@postgres:5432/postgres
PORT=3001
# Domain frontend yang boleh akses API (pisahkan koma), contoh:
CORS_ORIGIN=https://mutiari-garden-report.pages.dev,https://report.mutiari-garden.id

# Statistik tim dihitung mulai tanggal ini (default 2026-10-06).
# Dokumentasi lama tidak ikut skor biar fair.
CREW_STATS_SINCE=2026-10-06

# Notifikasi Telegram tiap dokumentasi baru (kosongkan = mati)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Link di pesan notifikasi (domain frontend)
FRONTEND_URL=https://domain-frontend.pages.dev
